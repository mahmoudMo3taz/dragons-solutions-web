# Copy this file to `.env` and adjust.

# Local development: a SQLite file inside /prisma (created by `npm run db:push`)
DATABASE_URL="file:./dev.db"

# Production examples (also change `provider` in prisma/schema.prisma):
# DATABASE_URL="postgresql://user:password@localhost:5432/dragons?schema=public"
# DATABASE_URL="sqlserver://localhost:1433;database=dragons;user=sa;password=YourPass;trustServerCertificate=true"

# Public site URL, used for metadata and links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
